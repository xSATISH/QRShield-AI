# =============================================================================
# QRShield AI - Environment Configuration
# =============================================================================
# Copy this file to .env and configure optional threat intelligence API keys.
# The application works fully in Local Analysis Mode without any API keys.

# Optional: VirusTotal API v3 Key (https://www.virustotal.com/)
VIRUSTOTAL_API_KEY=

# Optional: Google Safe Browsing API v4 Key (https://developers.google.com/safe-browsing)
SAFEBROWSING_API_KEY=

# Optional: Port configuration (Used by cloud deployment hosts like Render)
PORT=8501
